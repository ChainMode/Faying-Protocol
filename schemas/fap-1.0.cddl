; ============================================================================
; Normative; this is the authoritative schema for FAP/1.0 wire format.
; ============================================================================
;
; File:        schemas/fap-1.0.cddl
; Protocol:    Faying Protocol/1.0
;              (Historical alias: FAP / Faying Auth Protocol — deprecated;
;               retained only in this filename and the normative declaration
;               above for backward reference. All in-protocol identifiers
;               use the current name "Faying Protocol/1.0".)
; Status:      Authoritative wire-format schema. All other representations
;              (TypeScript types in `schemas/types.ts`, Proto3 in
;              `schemas/fap-1.0.proto`) are NON-NORMATIVE human-readable or
;              transport-binding views derived from this file.
; Source:      design.md §4.2 (verbatim). Any change to wire-format MUST land
;              here first, then propagate to §4.2.
; Encoding:    CBOR (RFC 8949). Deterministic CBOR encoding (RFC 8949 §4.2.1)
;              is REQUIRED for signature inputs (see design.md §6.3).
; References:  design.md §4 (Data Models), §5 (Protocol Messages),
;              §6 (Cryptography), §7 (Authorization Grades),
;              §11 (Endorsement), §12 (Disconnection).
; Validation:  Syntax checked with the `cddl` Ruby gem
;              (https://rubygems.org/gems/cddl) or equivalent.
;              Used as the decoding contract by:
;                - vectors/  (official test vectors, tasks 3.x)
;                - pbt/      (property-based test suite, tasks 4.x)
;                - conformance/ (interop conformance suite, tasks 5.x)
;
; ============================================================================

; Faying Protocol/1.0 — CBOR Data Definition Language
faying-grade = 0..4    ; 0=EmergencyOverride, 1=Strict, 2=Moderate, 3=Loose, 4=Autonomous

scope = {
  domains:    [* tstr],
  actions:    [* tstr],
  ? terminals: [* tstr],
  ? budget:   resource-budget
}

resource-budget = {
  time-window:        [iso-time, iso-time],
  ? max-invocations:  uint,
  ? max-cost-units:   uint
}

iso-time = #6.0(tstr)   ; CBOR tag 0 (RFC 3339 string)

presence-signal-type =
  "webauthn-uv-fresh" /
  "face-continuous"   /
  "fingerprint-tap"   /
  "presence-heartbeat-only" /
  "intent-ticket"

presence-requirement = {
  signal-types:        [+ presence-signal-type],
  max-staleness-ms:    uint,
  on-loss:             tstr            ; "downgrade-to:Gx" | "suspend" | "emergency-override"
}

attestation = {
  format:    "webauthn" / "tpm-quote" / "platform-keystore" / "self-signed",
  payload:   bstr,
  signer:    tstr,
  signature: signature-bundle
}

signature-bundle = {
  alg:       "Ed25519" / "ES256" / "ML-DSA-65",   ; PQC 协商位
  pubkey:    bstr,
  sig:       bstr,
  ? chain:   [* bstr]                              ; 可选证书链
}

mandate = {
  version:        "Faying Protocol/1.0",
  id:             tstr,
  issued-at:      iso-time,
  not-before:     iso-time,
  not-after:      iso-time,
  issuer:         tstr,        ; Human Prime ID
  ms-id:          tstr,
  subject:        tstr,        ; FayID
  scope:          scope,
  grade:          faying-grade,
  presence-req:   presence-requirement,
  ? parent:       tstr,
  ? endorsement:  endorsement,
  attestation:    attestation,
  signature:      signature-bundle
}

endorsement = {
  enabled:                       bool,
  endorsed-scope:                scope,         ; 必须 ⊆ 主 Mandate.scope
  endorsed-grade:                faying-grade,  ; 必须 ≤ 主 Mandate.grade（自主性更弱或相等，安全性更高）
  endorsed-lifetime-ms:          uint,          ; 必须 ≤ (mandate.not-after - mandate.not-before)
  offline-revocation-policy:     "stop-and-audit" / "stop-only" / "graceful-stop"
}

presence-signal = {
  mandate-id:           tstr,
  signal-type:          presence-signal-type,
  produced-at:          iso-time,
  nonce:                bstr .size 16,
  device-id:            tstr,
  device-attestation:   attestation,
  signature:            signature-bundle
}
