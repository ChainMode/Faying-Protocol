{
  "spec": "Faying Protocol/1.0",
  "vector_set": "encoding-equivalence",
  "purpose": "Demonstrate that CBOR (primary) and JSON (fallback) wire encodings are equivalent under §5.1 / §6.3: both deserialize to the same logical object, share a single Deterministic-CBOR signature input, and yield identical signature verification results.",
  "covers_message_types": [
    "BOOTSTRAP",
    "PRESENCE",
    "GRADE_SWITCH",
    "DELEGATE",
    "REVOKE"
  ],
  "fixed_seed": {
    "ed25519_seed_hex": "00112233445566778899aabbccddeeffffeeddccbbaa99887766554433221100",
    "ed25519_pubkey_hex": "296188d31c4dda4d7a7fd778b7241cda994ae1b8796f1acc705b638a26281582",
    "note": "Reproducible across runs. Generated by vectors/encoding-equivalence/generate.py."
  },
  "binary_field_convention_in_json": {
    "scheme": "base64url",
    "padding": "stripped (RFC 4648 §5, no '=' padding)",
    "rationale": "JSON has no native bytes type; base64url avoids '+', '/', and '=' which require quoting in URLs and HTTP headers. Receivers re-hydrate bytes by decoding the documented binary_field_paths in expected.json before comparing to the CBOR-decoded shape."
  },
  "key_naming_convention": "kebab-case (matches CDDL keys in schemas/fap-1.0.cddl)",
  "deterministic_cbor_rules": "RFC 8949 §4.2.1 Core Deterministic Encoding",
  "signature_input_definition": "H( Deterministic-CBOR( Envelope_without_signature ) )  (design.md §6.3 S2)",
  "hash_algorithm": "SHA-256",
  "signature_algorithm": "Ed25519",
